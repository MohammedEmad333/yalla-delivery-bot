# منفذ السيرفر (Render/Alwaysdata يحدده تلقائياً غالباً)
PORT=3000

# مجلد حفظ جلسة واتساب
AUTH_FOLDER=auth_info

# ملف تخزين الطلبات محلياً
ORDERS_FILE=orders.json

# ===== الربط بتطبيق يلا ديلفري (Yalla API) — إنشاء الطلب جاهزاً للإسناد =====
# رابط الـ API الأساسي (بدون / في النهاية) — يشمل بادئة /api
YALLA_API_URL=https://yalla-api-z6t0.onrender.com/api
# بيانات حساب أدمن في التطبيق (يستخدمها البوت لتسجيل الدخول والحصول على JWT)
YALLA_ADMIN_PHONE=
YALLA_ADMIN_PASSWORD=

# روابط تطبيق يلا ديلفري (أندرويد + تطبيق الويب)
APP_ANDROID_URL=https://play.google.com/apps/testing/com.mohammedemad333.yalla
APP_WEB_URL=https://yalla.mohammedelrefy28.workers.dev/

# الربط برمز اقتران بدل QR
USE_PAIRING_CODE=true
# رقم واتساب الأعمال (صيغة دولية بدون +)
BUSINESS_NUMBER=970593456405
# رقم واتساب الدعم/التواصل الظاهر للعملاء
SUPPORT_NUMBER=+970593456405

# ===== تسعير التوصيل (مطابق للتطبيق: كل 160م = 1 شيكل) =====
# العملة فقط قابلة للتعديل هنا؛ باقي معادلة السعر ثابتة في index.js لمطابقة التطبيق.
CURRENCY=₪

# مستوى السجلات: warn | info | debug
LOG_LEVEL=warn
